# Lecture Lens 构建用环境变量模板（可选）。
# 本项目在本机离线识别，不需要任何 API key / token / password。
# 用法：cp .env.example .env，按需填写后执行 `set -a; source .env; set +a`，再运行 ./build.sh。
# .env 已被 .gitignore 忽略，不会提交。

# 课件资料根目录，用于把术语出处定位到本机文件。
# 默认：~/Desktop/Moodle课程资料
LECTURELENS_MOODLE_DIR=

# 构建生成的 zip 安装包路径。
# 默认：~/LectureLensLocal/installers/Lecture Lens.zip
LECTURELENS_ARCHIVE=
