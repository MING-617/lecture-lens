+#if defined(__APPLE__)
+namespace {
+const qos_class_t kLectureLensBackground = QOS_CLASS_BACKGROUND;
+const qos_class_t kLectureLensUtility = QOS_CLASS_UTILITY;
+struct LectureLensWorker {
+  pthread_t thread;
+  OrtThreadWorkerFn function;
+  void *argument;
+};
+OrtCustomThreadHandle CreateLectureLensWorker(void *options, OrtThreadWorkerFn function,
+                                              void *argument) {
+  auto worker = new (std::nothrow) LectureLensWorker{nullptr, function, argument};
+  if (!worker) return nullptr;
+  pthread_attr_t attributes;
+  if (pthread_attr_init(&attributes) != 0) { delete worker; return nullptr; }
+  int status = pthread_attr_set_qos_class_np(&attributes, *static_cast<const qos_class_t *>(options), 0);
+  if (status == 0) {
+    status = pthread_create(&worker->thread, &attributes, [](void *value) -> void * {
+      auto w = static_cast<LectureLensWorker *>(value);
+      w->function(w->argument);
+      return nullptr;
+    }, worker);
+  }
+  pthread_attr_destroy(&attributes);
+  if (status != 0) { delete worker; return nullptr; }
+  return reinterpret_cast<OrtCustomThreadHandle>(worker);
+}
+void JoinLectureLensWorker(OrtCustomThreadHandle handle) {
+  auto worker = const_cast<LectureLensWorker *>(reinterpret_cast<const LectureLensWorker *>(handle));
+  pthread_join(worker->thread, nullptr);
+  delete worker;
+}
+}  // namespace
